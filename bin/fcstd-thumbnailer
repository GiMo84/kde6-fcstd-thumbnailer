#!/usr/bin/env bash
#
# Extract thumbnails/Thumbnail.png from a FreeCAD .FCStd ZIP archive.
# Called by KDE's standard external-thumbnailer support:
#   fcstd-thumbnailer INPUT OUTPUT [SIZE]
#
set -u

input=${1-}
output=${2-}

if [[ -z "$input" || -z "$output" || ! -r "$input" ]]; then
    exit 1
fi

command -v unzip >/dev/null 2>&1 || exit 1
command -v file  >/dev/null 2>&1 || exit 1

# Write atomically: a failed extraction must not leave a partial thumbnail.
tmp=$(mktemp -- "${output}.XXXXXX") || exit 1
cleanup() {
    rm -f -- "$tmp"
}
trap cleanup EXIT HUP INT TERM

# FreeCAD stores the embedded preview at this exact path inside the ZIP.
if ! unzip -p "$input" 'thumbnails/Thumbnail.png' >"$tmp" 2>/dev/null; then
    exit 1
fi

# Reject missing, empty, non-PNG, and implausibly large embedded previews.
size=$(stat -c '%s' -- "$tmp" 2>/dev/null) || exit 1
if (( size < 8 || size > 67108864 )); then
    exit 1
fi

mime=$(file --brief --mime-type -- "$tmp" 2>/dev/null) || exit 1
[[ "$mime" == "image/png" ]] || exit 1

mv -f -- "$tmp" "$output" || exit 1
trap - EXIT HUP INT TERM
exit 0
